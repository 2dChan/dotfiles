{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "read": {
      "*db.conf": "deny",
      "*.passwd": "deny",
    },
    "edit": {
      "*db.conf": "deny",
      "*.passwd": "deny",
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol-fast"
    },
    "build": {
      "model": "openai/gpt-5.6-terra-fast",
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    }
  }
}
